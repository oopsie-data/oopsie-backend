digraph pipeline {
  rankdir=LR; dpi=150;
  node [shape=box, style="rounded,filled", fillcolor="#e8f0fe", fontname="Helvetica"];
  edge [color="#555555"];
  mirror [label="local mirror", shape=cylinder, fillcolor="#fff4d6"];
  node [fillcolor="#eeeeee"];
  hub_mirror; mirror_state; camera_names_config; qa_check_versions; critical_config; stats_config; split_config; annotation_state; training_recipe_state;
  node [fillcolor="#fde2e2"];
  imported_datasets [label="imported_datasets\n(manual)"]; training_data [label="training_data\n(manual)"];
  node [fillcolor="#e8f0fe"];
  hub_mirror -> mirror; hub_mirror -> mirror_state; mirror -> mirror_state;
  mirror_state -> episode_index;
  hub_mirror -> hub_upload_times; episode_index -> hub_upload_times;
  episode_index -> duplicate_episodes;
  duplicate_episodes -> unified_camera_names; camera_names_config -> unified_camera_names;
  duplicate_episodes -> duplicate_videos;
  duplicate_episodes -> qa_results; qa_check_versions -> qa_results;
  duplicate_videos -> critical_episodes; qa_results -> critical_episodes; critical_config -> critical_episodes;
  critical_episodes -> stats; stats_config -> stats;
  critical_episodes -> eval_proposals;
  split_config -> eval_proposals; split_config -> chosen_proposal; split_config -> train_sample; split_config -> annotator_assignments;
  eval_proposals -> chosen_proposal;
  chosen_proposal -> eval_split; chosen_proposal -> train_sample; chosen_proposal -> annotator_assignments;
  train_sample -> annotator_assignments;
  annotator_assignments -> annotation_columns; annotation_state -> annotation_columns;
  imported_datasets -> mirror [style=dashed, label="imports/ folder", fontsize=10];
  critical_episodes -> training_data; eval_split -> training_data; annotation_columns -> training_data;
  unified_camera_names -> training_data; training_recipe_state -> training_data;
}
